# 이 파일을 .env로 복사하고 chmod 600 .env를 실행하세요.
# .env는 Bash로 실행됩니다. 직접 작성한 신뢰할 수 있는 파일만 사용하세요.
# openssl rand -hex 32로 토큰을 생성한 뒤 아래 JSON에 직접 넣으세요.
# 예시 형식: WAYNUDGE_USERS='{"me":"생성한-32자-이상-ASCII-토큰"}'
# 사용자마다 서로 다른 32~256자의 공백 없는 ASCII 토큰이 필요합니다.
WAYNUDGE_USERS=''
DATABASE_URL='sqlite://waynudge.db'
# 기본값은 로컬 전용. 컨테이너에서만 0.0.0.0:8080 사용.
BIND_ADDR='127.0.0.1:8080'
TRANSIT_PROVIDER='mock'
# 모의 지하철 장애 시연: 0~180분. 실제 운행정보가 아닙니다.
MOCK_SUBWAY_DELAY_MINUTES='0'

# 실제 ODsay 사용 권한과 API 키가 있을 때만 odsay로 변경하세요.
ODSAY_API_KEY=''
ODSAY_DAILY_LIMIT='30'
# 기본값 0: 캐시 비활성. ODsay의 명시적 저장 허용을 받은 경우만 1~300초 설정.
ODSAY_CACHE_SECONDS='0'

# 공휴일 자동 내장 없음. 공식 한국 공휴일을 확인하여 YYYY-MM-DD를 쉼표로 구분.
# 공백을 넣지 마세요. 비어 있으면 요일과 개별 날짜 설정만 적용됩니다.
HOLIDAYS=''
# 브라우저 Origin 허용이 필요할 때만 터널 호스트명 설정(https://와 경로 제외).
# PUBLIC_HOST='발급받은이름.trycloudflare.com'
